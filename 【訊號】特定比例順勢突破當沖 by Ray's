inputs:
    BreakoutPct(0.006),   // 當日相對開盤價，上/下都必須先突破這個比例，才視為有效的雙向震盪
    StopLossPct(0.005),   // 停損百分比（相對進場價）
    EntryStart(0900),     // 進場時間下限
    EntryEnd(1300),       // 進場時間上限（超過不再新進場）
    FlattenTime(1325);    // 強制平倉時間

vars:
    longTakenToday(false),
    shortTakenToday(false);

if date<>date[1] then begin
    longTakenToday = false;
    shortTakenToday = false;
end;

{ 當天高點已經比開盤價高出 BreakoutPct% 以上、低點也已經比開盤價低出 BreakoutPct% 以上，
  代表今天是雙向都走出行情的震盪日，才相信高/低點的突破是真的順勢延續，而非開盤附近的假突破 }
condition1 = highd(0)>=opend(0)*(1+BreakoutPct);
condition3 = lowd(0)<=opend(0)*(1-BreakoutPct);

{ condition2 / condition4 與 condition1 / condition3 判斷邏輯相同，
  但多考慮「本根K棒是否正好創當日新高/新低」，避免即時走勢中 highd/lowd 與 high/low
  更新時間點不同步，在剛創出但尚未站穩門檻的瞬間就誤判 }
condition2 = (high=highd(0) and high>=opend(0)*(1+BreakoutPct)) or high<highd(0);
condition4 = (low=lowd(0) and low<=opend(0)*(1-BreakoutPct)) or low>lowd(0);

if marketposition=0 and not longTakenToday and time>EntryStart and time<=EntryEnd
   and condition1 and condition3 then
    buy("Long_BO") next bar at highd(0) stop;

if marketposition=0 and not shortTakenToday and time>EntryStart and time<=EntryEnd
   and condition2 and condition4 then
    sellshort("Short_BO") next bar at lowd(0) stop;

{ 固定百分比停損 }
if marketposition<0 then begin
    buytocover("SL_Short") next bar at entryprice*(1+StopLossPct) stop;
    shortTakenToday = true;
end;

if marketposition>0 then begin
    sell("SL_Long") next bar at entryprice*(1-StopLossPct) stop;
    longTakenToday = true;
end;

{ 收盤前強制平倉，避免留倉過夜 }
if time>=FlattenTime then begin
    sell("EOD_Long") next bar at market;
    buytocover("EOD_Short") next bar at market;
end;

setexitonclose;
